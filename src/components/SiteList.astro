---
import type { SiteLink } from '../lib/data';
const { title, links } = Astro.props as { title: string; links: SiteLink[] };
---
<details class="block" open>
  <summary>
    List of {title} Sites
    <span class="count-badge">{links.length} Websites</span>
  </summary>
  <div class="block-body">
    {links.length > 0 ? (
      links.map((s, i) => (
        <div class="site-item">
          <h3>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {i + 1} - {s.title}
            </a>
          </h3>
          {s.description && <p>{s.description}</p>}
        </div>
      ))
    ) : (
      <p class="empty">No websites listed in this category.</p>
    )}
  </div>
</details>