---
import { pathToSlug, type SubcategoryRef } from '../lib/data';
const { title, subcategories } = Astro.props as { title: string; subcategories: SubcategoryRef[] };
---
{subcategories.length > 0 && (
  <details class="block" open>
    <summary>
      Subcategories under {title}
      <span class="count-badge">{subcategories.length}</span>
    </summary>
    <div class="subcat-grid">
      {subcategories.map((sc) => (
        <a href={`/${pathToSlug(sc.full_path)}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z" />
          </svg>
          {sc.title}
        </a>
      ))}
    </div>
  </details>
)}