---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteList from '../components/SiteList.astro';
import SubcategoryGrid from '../components/SubcategoryGrid.astro';
import { getAllCategories, getCategoryBySlug, buildCrumbs } from '../lib/data';

// Generate one static page per category (all ~45,000 of them)
export async function getStaticPaths() {
  return [...getAllCategories().keys()].map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const category = getCategoryBySlug(slug);
---

{category ? (
  <BaseLayout title={`${category.title} Websites - HumanWeb`}>
    <Header crumbs={buildCrumbs(category.full_path)} />
    <main class="page">
      <h1 class="page-title">{category.title} Websites</h1>

      <div class="desc-box">
        {category.description
          ? <Fragment set:html={category.description} />
          : <p>Curated directory of high-quality websites about {category.title}.</p>}
        <p class="cat-id">- Category ID : {category.id}</p>
      </div>

      <SiteList title={category.title} links={category.links} />
      <SubcategoryGrid title={category.title} subcategories={category.subcategories} />
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Category not found - HumanWeb">
    <Header crumbs={[{ label: 'Not Found' }]} />
    <main class="page">
      <h1 class="page-title">Category not found</h1>
      <p><a href="/">← Back to home</a></p>
    </main>
  </BaseLayout>
)}