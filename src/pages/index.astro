---
import BaseLayout from '../layouts/BaseLayout.astro';

const LIST_SOURCES = ['fmhy', 'awesome', 'selfhosted', 'freefordev', 'vlib', 'apis', 'devbooks', 'buildyourownx', 'privacy', 'usefulsites', 'openwebsearch', 'commoncrawl'];
---
<BaseLayout title="HumanWeb — the human-curated web">
  <header class="top">
    <div class="mast-inner">
      <div class="title-row">
        <svg class="mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <ellipse cx="12" cy="12" rx="4.2" ry="9" />
          <path d="M3 12h18M4.6 7h14.8M4.6 17h14.8" />
        </svg>
        <h1>Human<span>Web</span></h1>
        <button id="theme-toggle" class="theme-toggle" aria-label="Switch color theme">
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.4" />
            <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19" />
          </svg>
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.4 14.2A8.6 8.6 0 0 1 9.8 3.6a8.6 8.6 0 1 0 10.6 10.6Z" />
          </svg>
        </button>
      </div>
      <p class="tagline">The human-curated web — one tab per source, never mixed.</p>
    </div>
  </header>

  <nav class="tabs" id="tabs" aria-label="Data sources"></nav>

  <main>
    <section class="panel" id="panel-curlie" hidden>
      <div class="panel-head">
        <div>
          <h2>Curlie</h2>
          <p class="sub" id="curlie-sub"></p>
        </div>
        <p class="stats" id="curlie-stats"></p>
      </div>
      <div class="curlie-wrap">
        <aside class="curlie-treebox" aria-label="Directory tree">
          <div class="tree-label">Branches</div>
          <div id="curlie-tree"></div>
        </aside>
        <div class="curlie-main">
          <nav class="crumbs" id="crumbs"></nav>
          <input class="filter" id="curlie-filter" type="search"
                 placeholder="Filter inside this category (title, URL, description)…" />
          <div class="status" id="curlie-status"></div>
          <h3 class="section-h" id="curlie-cats-h" hidden>Categories</h3>
          <div class="chips" id="curlie-cats"></div>
          <h3 class="section-h" id="curlie-links-h" hidden>Websites</h3>
          <ul class="links" id="curlie-links"></ul>
          <button class="more" id="curlie-more" hidden>Show more</button>
        </div>
      </div>
    </section>

    {LIST_SOURCES.map((src) => (
      <section class="panel" id={`panel-${src}`} hidden>
        <div class="panel-head">
          <div>
            <h2>{src}</h2>
            <p class="sub" data-role="sub"></p>
          </div>
          <p class="stats" data-role="stats"></p>
        </div>
        <div class="pagechips" data-role="pages"></div>
        <input class="filter" type="search" data-role="filter"
               placeholder="Search everything in this source…" />
        <div class="status" data-role="status"></div>
        <div data-role="content"></div>
        <button class="more" data-role="more" hidden>Show more</button>
      </section>
    ))}

    <section class="panel" id="panel-contribute" hidden>
      <div class="panel-head">
        <div>
          <h2>Contribute</h2>
          <p class="sub">Not a source — a handpicked map of places where anyone can add to the web's shared knowledge, for free.</p>
        </div>
      </div>

      <details class="sec">
        <summary>Citizen science<span class="cnt">6 platforms</span><button class="up-btn" data-up aria-label="Back to top" title="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button></summary>
        <ul class="links">
          <li><a href="https://www.zooniverse.org" target="_blank" rel="noopener">Zooniverse</a><span class="u">zooniverse.org</span><p>Classify galaxies, animals and handwritten archives — the biggest citizen-science platform on the web.</p></li>
          <li><a href="https://scistarter.org" target="_blank" rel="noopener">SciStarter</a><span class="u">scistarter.org</span><p>A directory of thousands of projects that need your observations, from backyards to telescopes.</p></li>
          <li><a href="https://www.inaturalist.org" target="_blank" rel="noopener">iNaturalist</a><span class="u">inaturalist.org</span><p>Photograph any living thing; the community identifies it and scientists map life from your data.</p></li>
          <li><a href="https://ebird.org" target="_blank" rel="noopener">eBird</a><span class="u">ebird.org</span><p>Report the birds you see; Cornell Lab turns checklists into real research and conservation.</p></li>
          <li><a href="https://fold.it" target="_blank" rel="noopener">Foldit</a><span class="u">fold.it</span><p>Play protein-folding puzzles — players have co-authored papers on designs labs then built.</p></li>
          <li><a href="https://stallcatchers.com" target="_blank" rel="noopener">Stall Catchers</a><span class="u">stallcatchers.com</span><p>Spot stalled blood vessels in brain movies to speed up Alzheimer's research, one minute at a time.</p></li>
        </ul>
      </details>

      <details class="sec">
        <summary>Shared knowledge<span class="cnt">7 platforms</span><button class="up-btn" data-up aria-label="Back to top" title="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button></summary>
        <ul class="links">
          <li><a href="https://www.wikipedia.org" target="_blank" rel="noopener">Wikipedia</a><span class="u">wikipedia.org</span><p>Fix a typo or write a missing article on the encyclopedia anyone can edit.</p></li>
          <li><a href="https://commons.wikimedia.org" target="_blank" rel="noopener">Wikimedia Commons</a><span class="u">commons.wikimedia.org</span><p>Upload photographs and media the whole world can freely use.</p></li>
          <li><a href="https://www.wikidata.org" target="_blank" rel="noopener">Wikidata</a><span class="u">wikidata.org</span><p>Add facts to the structured knowledge base that powers search engines and assistants.</p></li>
          <li><a href="https://www.openstreetmap.org" target="_blank" rel="noopener">OpenStreetMap</a><span class="u">openstreetmap.org</span><p>Trace the road or shop your neighborhood is missing onto the free map of everything.</p></li>
          <li><a href="https://www.pgdp.net" target="_blank" rel="noopener">Distributed Proofreaders</a><span class="u">pgdp.net</span><p>Proofread one page at a time to free a whole book into Project Gutenberg.</p></li>
          <li><a href="https://librivox.org" target="_blank" rel="noopener">LibriVox</a><span class="u">librivox.org</span><p>Read a chapter aloud; volunteers record public-domain audiobooks, one clip each.</p></li>
          <li><a href="https://curlie.org" target="_blank" rel="noopener">Curlie</a><span class="u">curlie.org</span><p>The directory in the first tab of this very site — suggest and edit listings yourself.</p></li>
        </ul>
      </details>

      <details class="sec">
        <summary>Code the web<span class="cnt">4 platforms</span><button class="up-btn" data-up aria-label="Back to top" title="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button></summary>
        <ul class="links">
          <li><a href="https://github.com/firstcontributions/first-contributions" target="_blank" rel="noopener">First Contributions</a><span class="u">github.com</span><p>A repo that walks you through your very first pull request, step by step.</p></li>
          <li><a href="https://goodfirstissue.dev" target="_blank" rel="noopener">Good First Issue</a><span class="u">goodfirstissue.dev</span><p>Find an open-source project that needs exactly the task you can do first.</p></li>
          <li><a href="https://upforgrabs.net" target="_blank" rel="noopener">Up For Grabs</a><span class="u">upforgrabs.net</span><p>Beginner-labeled tasks across hundreds of projects, ready to claim.</p></li>
          <li><a href="https://github.com/mdn/content" target="_blank" rel="noopener">MDN Web Docs</a><span class="u">github.com</span><p>The documentation every developer reads is open source — improve a page you know.</p></li>
        </ul>
      </details>

      <details class="sec">
        <summary>Feed the lists behind the other tabs<span class="cnt">6 platforms</span><button class="up-btn" data-up aria-label="Back to top" title="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button></summary>
        <ul class="links">
          <li><a href="https://github.com/nbats/FMHYedit" target="_blank" rel="noopener">FMHY</a><span class="u">github.com</span><p>The FMHY tab here is a community wiki — send an edit to the biggest list of free media.</p></li>
          <li><a href="https://github.com/sindresorhus/awesome" target="_blank" rel="noopener">Awesome</a><span class="u">github.com</span><p>Improve or propose an awesome list — every list here started as someone's pull request.</p></li>
          <li><a href="https://github.com/awesome-selfhosted/awesome-selfhosted" target="_blank" rel="noopener">Awesome Selfhosted</a><span class="u">github.com</span><p>Know a self-hostable tool that's missing? Add it to the list.</p></li>
          <li><a href="https://github.com/public-apis/public-apis" target="_blank" rel="noopener">Public APIs</a><span class="u">github.com</span><p>Document an API you use so the next developer finds it faster.</p></li>
          <li><a href="https://github.com/ripienaar/free-for-dev" target="_blank" rel="noopener">Free for Dev</a><span class="u">github.com</span><p>Add a free tier you've tested — this list is maintained entirely by submissions.</p></li>
          <li><a href="https://github.com/EbookFoundation/free-programming-books" target="_blank" rel="noopener">Free Programming Books</a><span class="u">github.com</span><p>Contribute books and courses in any language to the most-starred repo on GitHub.</p></li>
        </ul>
      </details>
    </section>

    <noscript><p style="text-align:center">HumanWeb needs JavaScript to load and decompress the directory data in your browser.</p></noscript>
  </main>

  <script>
    // ============================== helpers ==================================
    const $ = (sel, el = document) => el.querySelector(sel);
    const $$ = (sel, el = document) => [...el.querySelectorAll(sel)];
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const fmt = (n) => Number(n ?? 0).toLocaleString("en-US");
    const fmtShort = (n) =>
      n >= 1e6 ? (n / 1e6).toFixed(1).replace(/\.0$/, "") + "M"
      : n > 9999 ? Math.round(n / 1000) + "k"
      : String(n);
    const toTop = () =>
      window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    const UP_BTN = `<button class="up-btn" data-up aria-label="Back to top" title="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>`;
    const wireUpButtons = (el) =>
      el.addEventListener("click", (e) => {
        const b = e.target.closest("[data-up]");
        if (b) { e.preventDefault(); toTop(); } // prevent the summary toggle too
      });

    async function fetchAny(url, tries = 3) {
      let lastErr;
      for (let attempt = 0; attempt < tries; attempt++) {
        try {
          const r = await fetch(url);
          if (!r.ok) throw new Error(`${r.status} ${url}`);
          const bytes = new Uint8Array(await r.arrayBuffer());
          // Sniff the gzip magic — some servers deliver .gz with Content-Encoding
          // already set (browser decodes it), others as raw application/gzip.
          if (bytes[0] === 0x1f && bytes[1] === 0x8b) {
            if (!("DecompressionStream" in window)) {
              throw new Error("This browser lacks DecompressionStream — please update it.");
            }
            const ds = new DecompressionStream("gzip");
            return await new Response(new Blob([bytes]).stream().pipeThrough(ds)).text();
          }
          return new TextDecoder().decode(bytes);
        } catch (e) {
          lastErr = e;
          await new Promise((res) => setTimeout(res, 350 * (attempt + 1)));
        }
      }
      throw lastErr;
    }
    const fetchJSON = async (url) => JSON.parse(await fetchAny(url));

    async function fetchNDJSON(url) {
      const map = new Map();
      for (const line of (await fetchAny(url)).split("\n")) {
        if (!line) continue;
        const [path, links] = JSON.parse(line);
        map.set(path, links);
      }
      return map;
    }

    // ============================== tabs / router ============================
    const catalog = await fetchJSON("data/index.json").catch(() => ({ sources: [] }));
    const SOURCES = catalog.sources.length
      ? catalog.sources
      : [{ id: "curlie", title: "Curlie", subtitle: "", links: 0, note: "" }];
    // The Contribute tab is a static editorial panel, not a data source.
    SOURCES.push({
      id: "contribute",
      title: "Contribute",
      subtitle: "Places that accept your help — science, knowledge, code",
      links: document.querySelectorAll("#panel-contribute .links a").length,
      note: "",
    });
    const byId = Object.fromEntries(SOURCES.map((s) => [s.id, s]));

    const tabsEl = $("#tabs");
    tabsEl.innerHTML = SOURCES.map((s) => `
      <button class="tab" data-src="${s.id}" title="${esc(s.subtitle)}">
        ${esc(s.title)}
        ${s.links ? `<span class="n">${fmtShort(s.links)}</span>` : ""}
      </button>`).join("");
    tabsEl.addEventListener("click", (e) => {
      const b = e.target.closest(".tab");
      if (b) location.hash = b.dataset.src;
    });

    function setActive(id) {
      document.documentElement.dataset.src = id; // the whole page takes the drawer's ink
      const active = $$(".tab", tabsEl).find((t) => t.dataset.src === id);
      $$(".tab", tabsEl).forEach((t) => t.classList.toggle("active", t === active));
      active?.scrollIntoView({ block: "nearest", inline: "nearest" }); // phone: the bar scrolls
      $$("main .panel").forEach((p) => (p.hidden = p.id !== `panel-${id}`));
    }

    function route() {
      const h = decodeURIComponent(location.hash.replace(/^#\/?/, ""));
      const [src, ...rest] = h.split("/");
      const id = byId[src] ? src : "curlie";
      const sub = rest.join("/");
      setActive(id);
      if (id === "curlie") openCurlie(sub);
      else if (id !== "contribute") openLister(id, sub).catch((e) => showErr(id, e));
    }
    window.addEventListener("hashchange", route);

    function showErr(id, e) {
      const p = $(`#panel-${id} [data-role=status]`) || $(`#curlie-status`);
      if (p) {
        p.classList.add("err");
        p.textContent = `⚠ Could not load this source (${e.message || e}). `;
        const b = document.createElement("button");
        b.className = "retry";
        b.textContent = "Retry";
        b.onclick = () => { p.textContent = ""; p.classList.remove("err"); route(); };
        p.appendChild(b);
      }
      console.error(e);
    }

    // ============================== curlie browser ===========================
    const LETTER_CAT = /^[a-z]$/i; // Curlie's empty A–Z placeholder categories
    const C = {
      ready: false, meta: null, tree: [], nodes: new Map(), refs: new Map(),
      files: new Map(), path: "", filter: "", shown: 100,
      expanded: new Set(), // tree branches the visitor opened by hand
    };

    function flashPanel(sel) {
      const panel = $(sel);
      if (!panel) return;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({
        top: Math.max(0, panel.getBoundingClientRect().top + window.scrollY - 12),
        behavior: reduced ? "auto" : "smooth",
      });
      panel.classList.remove("flash");
      void panel.offsetWidth;
      panel.classList.add("flash");
    }

    async function initCurlie() {
      if (C.ready) return;
      // meta and tree are independent — fetch them together
      [C.meta, C.tree] = await Promise.all([
        fetchJSON("data/curlie/meta.json"),
        fetchJSON("data/curlie/tree.json.gz"),
      ]);
      const indexNode = (nd, base) => {
        const seg = nd.t.replace(/ /g, "_");
        const p = base ? `${base}/${seg}` : seg;
        nd._p = p;
        C.nodes.set(p, nd);
        if (nd.r) {
          C.refs.set(p, nd.r);
          const flat = (ref) => {
            if (ref.k) for (const [cp, cr] of Object.entries(ref.k)) { C.refs.set(cp, cr); flat(cr); }
          };
          flat(nd.r);
        }
        (nd.c ?? []).forEach((ch) => indexNode(ch, p));
      };
      C.tree.forEach((r) => indexNode(r, ""));
      $("#curlie-sub").textContent = C.meta.subtitle || "";
      const tot = C.meta.totals ?? {};
      $("#curlie-stats").innerHTML =
        `<b>${fmt(tot.links_kept)}</b> websites · <b>${fmt(tot.categories_kept)}</b> categories` +
        (C.meta.dump_date ? ` · dump ${C.meta.dump_date}` : "") +
        ` · adult &amp; anime excluded · <a href="https://curlie.org" target="_blank" rel="noopener">curlie.org</a>`;
      C.ready = true;
    }

    function coveringRef(P) {
      const ref = C.refs.get(P);
      if (ref) {
        if (ref.f && !ref.s) return { file: ref.f };
        if (ref.s) return { self: ref.f ?? null, k: ref.k ?? {} };
      }
      let q = P;
      while (q.includes("/")) {
        q = q.slice(0, q.lastIndexOf("/"));
        const r2 = C.refs.get(q);
        if (r2 && r2.f && !r2.s) return { file: r2.f };
      }
      return null;
    }

    function getRecords(name) {
      if (!C.files.has(name)) C.files.set(name, fetchNDJSON(`data/curlie/c/${name}`));
      const p = C.files.get(name);
      p.then(() => {  // simple LRU: keep ~6 parsed chunks in memory
        if (C.files.size > 6) {
          for (const [k] of C.files) {
            if (C.files.size <= 6) break;
            C.files.delete(k);
          }
        }
      });
      return p;
    }

    function linkLi([t, u, d]) {
      let host = "";
      try { host = new URL(u).hostname.replace(/^www\./, ""); } catch { /* keep */ }
      return `<li>
        <a href="${esc(u)}" target="_blank" rel="noopener noreferrer nofollow">${esc(t || host)}</a>
        <span class="u">${esc(host)}</span>
        ${d ? `<p>${esc(d)}</p>` : ""}
      </li>`;
    }

    async function showCurlie(P, opts = {}) {
      const status = $("#curlie-status");
      status.classList.remove("err");
      try {
        if (!C.ready) { status.textContent = "Loading directory index…"; await initCurlie(); }
        P = (P || "").replace(/\/+$/, "");
        C.path = P; C.filter = ""; C.shown = 100;
        $("#curlie-filter").value = "";
        renderCrumbs(P);

        const cov = coveringRef(P);
        let own = [];
        let subcats = [];

        if (cov && cov.file) {
          status.textContent = "Loading category data…";
          const recs = await getRecords(cov.file);
          own = recs.get(P) ?? [];
          const prefix = P ? `${P}/` : "";
          const agg = new Map();
          for (const [p, links] of recs) {
            if (p === P || (prefix && !p.startsWith(prefix))) continue;
            const seg = p.slice(prefix.length).split("/")[0];
            const cp = prefix + seg;
            const e = agg.get(cp) ?? { path: cp, title: seg.replace(/_/g, " "), links: 0, cats: 0 };
            e.links += links.length; e.cats += 1;
            agg.set(cp, e);
          }
          subcats = [...agg.values()].sort((a, b) => b.links - a.links || a.title.localeCompare(b.title));
          status.textContent = "";
        } else if (cov && "k" in cov) {
          if (cov.self) {
            status.textContent = "Loading category data…";
            own = (await getRecords(cov.self)).get(P) ?? [];
          }
          subcats = Object.entries(cov.k)
            .map(([cp, cr]) => ({
              path: cp, title: cp.split("/").pop().replace(/_/g, " "),
              links: null, cats: cr.n ?? 0,
            }))
            .sort((a, b) => a.title.localeCompare(b.title));
          status.textContent = "";
        } else {
          const nd = C.nodes.get(P);
          subcats = (nd?.c ?? C.tree)
            .map((ch) => ({ path: ch._p, title: ch.t, links: ch.tot, cats: null }))
            .sort((a, b) => b.links - a.links);
        }

        subcats = subcats.filter((s) => !LETTER_CAT.test(s.title));
        renderCurlie(P, subcats, own);
        renderTree(P);
        if (opts.scroll !== false) flashPanel("#panel-curlie");
      } catch (e) { showErr("curlie", e); }
    }

    function renderCrumbs(P) {
      const el = $("#crumbs");
      const parts = P ? P.split("/") : [];
      const mk = (label, path, here) =>
        here ? `<span class="here">${esc(label)}</span>`
             : `<a data-go="${esc(path)}">${esc(label)}</a>`;
      let html = mk("Curlie", "", parts.length === 0);
      parts.forEach((seg, i) => {
        html += ` <span class="sep">›</span> ` + mk(seg.replace(/_/g, " "), parts.slice(0, i + 1).join("/"), i === parts.length - 1);
      });
      el.innerHTML = html;
      el.onclick = (e) => {
        const a = e.target.closest("[data-go]");
        if (a) location.hash = `curlie/${a.dataset.go}`.replace(/\/$/, "");
      };
    }

    // Branch sidebar, curlie.org style: the whole path stays visible and
    // expandable, the branch you are in is opened down to where you are.
    function renderTree(P) {
      const el = $("#curlie-tree");
      if (!el) return;
      const segs = P ? P.split("/") : [];
      const node = (nd, depth) => {
        const kids = (nd.c ?? []).filter((k) => !LETTER_CAT.test(k.t));
        const onPath = nd._p === segs.slice(0, depth + 1).join("/");
        const isOpen = onPath || C.expanded.has(nd._p);
        const caret = kids.length
          ? `<button class="tcar" data-p="${esc(nd._p)}" aria-expanded="${isOpen}" aria-label="${isOpen ? "Collapse" : "Expand"} ${esc(nd.t)}"></button>`
          : `<span class="tcar nix"></span>`;
        const kidsHtml = isOpen && kids.length
          ? `<ul class="tkids">${kids.map((k) => node(k, depth + 1)).join("")}</ul>`
          : "";
        return `<li class="tnode${isOpen ? " open" : ""}${kids.length ? "" : " kids-none"}">
          <div class="trow">${caret}<a class="tl${nd._p === P ? " here" : ""}" href="#curlie/${esc(nd._p)}">${esc(nd.t)}</a>${nd.tot ? `<span class="tn">${fmt(nd.tot)}</span>` : ""}</div>
          ${kidsHtml}</li>`;
      };
      el.innerHTML = `<ul class="tree">${C.tree.map((r) => node(r, 0)).join("")}</ul>`;
      el.onclick = (e) => {
        const car = e.target.closest(".tcar[data-p]");
        if (!car) return;
        const p = car.dataset.p;
        if (C.expanded.has(p)) C.expanded.delete(p); else C.expanded.add(p);
        renderTree(C.path);
      };
    }

    function renderCurlie(P, subcats, own) {
      const q = C.filter.toLowerCase();
      const fSub = q ? subcats.filter((s) => s.title.toLowerCase().includes(q)) : subcats;
      const fOwn = q ? own.filter((l) => (l[0] + " " + l[1] + " " + (l[2] || "")).toLowerCase().includes(q)) : own;

      $("#curlie-cats-h").hidden = !fSub.length;
      $("#curlie-cats").innerHTML = fSub.slice(0, 400).map((s) => `
        <button class="chip" data-go="${esc(s.path)}">
          <span>${esc(s.title)}</span>
          <span class="n">${s.links != null ? `${fmt(s.links)} sites` : `${fmt(s.cats)} cats`}</span>
        </button>`).join("") +
        (fSub.length > 400 ? `<p class="status">+ ${fmt(fSub.length - 400)} more categories — use the filter</p>` : "");
      $("#curlie-cats").onclick = (e) => {
        const b = e.target.closest("[data-go]");
        if (b) location.hash = `curlie/${b.dataset.go}`;
      };

      const node = C.nodes.get(P);
      const desc = node?.d;
      $("#curlie-links-h").hidden = !fOwn.length && !desc;
      $("#curlie-links").innerHTML =
        (desc && !q ? `<li class="desc-li"><p>${esc(desc)}</p></li>` : "") +
        fOwn.slice(0, C.shown).map(linkLi).join("");
      const moreBtn = $("#curlie-more");
      moreBtn.hidden = fOwn.length <= C.shown;
      moreBtn.textContent = `Show more (${fmt(fOwn.length - C.shown)} left)`;
      moreBtn.onclick = () => { C.shown += 200; renderCurlie(P, subcats, own); };
      $("#curlie-status").textContent = fOwn.length
        ? `${fmt(fOwn.length)} websites in ${esc(P.split("/").pop().replace(/_/g, " ")) || "Curlie"}`
        : "";
    }

    function openCurlie(sub) {
      initCurlie()
        .then(() => showCurlie(sub))
        .catch((e) => showErr("curlie", e));
    }

    $("#curlie-filter").addEventListener("input", (e) => {
      C.filter = e.target.value.trim();
      C.shown = 100;
      showCurlie(C.path, { scroll: false });
    });

    // ============================== list sources =============================
    const L = {};   // src -> {meta, data, page, filter, shown}

    async function openLister(src, sub) {
      const panel = $(`#panel-${src}`);
      const status = $('[data-role=status]', panel);
      status.classList.remove("err");
      if (!L[src]) {
        status.textContent = "Loading data…";
        const [meta, data] = await Promise.all([
          fetchJSON(`data/${src}/meta.json`),
          fetchJSON(`data/${src}/data.json.gz`),
        ]);
        L[src] = { meta, data, page: sub && meta.pages?.some((p) => p.id === sub) ? sub : (meta.pages?.[0]?.id ?? ""), filter: "", shown: 60 };
        const s = byId[src] ?? {};
        $(".panel-head h2", panel).textContent = s.title ?? src;
        $('[data-role=sub]', panel).textContent = meta.subtitle || s.subtitle || "";
        $('[data-role=stats]', panel).innerHTML =
          `<b>${fmt(meta.totals.links)}</b> links · <b>${fmt(meta.totals.pages)}</b> pages` +
          (meta.homepage ? ` · <a href="${esc(meta.homepage)}" target="_blank" rel="noopener">homepage</a>` : "");
        renderPages(src);
        wireUpButtons($('[data-role=content]', panel));
        $('[data-role=filter]', panel).addEventListener("input", (e) => {
          L[src].filter = e.target.value.trim(); L[src].shown = 60; renderLister(src);
        });
        $('[data-role=more]', panel).onclick = () => { L[src].shown += 100; renderLister(src); };
      }
      if (sub && L[src].meta.pages?.some((p) => p.id === sub) && L[src].page !== sub) {
        L[src].page = sub;
        renderPages(src);
      }
      status.textContent = "";
      renderLister(src);
    }

    function renderPages(src) {
      const panel = $(`#panel-${src}`);
      const st = L[src];
      const pages = st.meta.pages ?? [];
      $('[data-role=pages]', panel).innerHTML = pages.map((p) => `
        <button class="pchip ${p.id === st.page ? "active" : ""}" data-page="${esc(p.id)}">
          ${esc(p.title)}<span class="n">${fmt(p.links)}</span>
        </button>`).join("");
      $('[data-role=pages]', panel).onclick = (e) => {
        const b = e.target.closest("[data-page]");
        if (!b) return;
        st.page = b.dataset.page;
        st.shown = 60;
        renderPages(src);
        renderLister(src);
        history.replaceState(null, "", `#${src}/${st.page}`);
      };
    }

    function renderLister(src) {
      const panel = $(`#panel-${src}`);
      const st = L[src];
      const q = st.filter.toLowerCase();
      const content = $('[data-role=content]', panel);
      const status = $('[data-role=status]', panel);
      const pageTitle = st.meta.pages?.find((p) => p.id === st.page)?.title ?? st.page;
      let sections;

      if (q) {
        sections = st.data
          .map((s) => ({ p: s.p, l: s.l.filter((x) => (x[0] + " " + x[1] + " " + (x[2] || "")).toLowerCase().includes(q)) }))
          .filter((s) => s.l.length);
      } else {
        const pref = `${pageTitle} / `;
        sections = st.data.filter((s) => s.p === pageTitle || s.p.startsWith(pref));
      }
      const total = sections.reduce((a, s) => a + s.l.length, 0);
      status.textContent = q
        ? `${fmt(total)} links match “${st.filter}” across ${fmt(sections.length)} sections`
        : `${fmt(total)} links in ${pageTitle}`;

      const cap = st.shown;
      content.innerHTML = sections.slice(0, 60).map((s) => `
        <details class="sec">
          <summary>${esc(s.p)}<span class="cnt">${fmt(s.l.length)}</span>${UP_BTN}</summary>
          <ul class="links">${s.l.slice(0, cap).map(linkLi).join("")}</ul>
          ${s.l.length > cap ? `<p class="more-note">+ ${fmt(s.l.length - cap)} more…</p>` : ""}
        </details>`).join("") +
        (sections.length > 60 ? `<p class="status">+ ${fmt(sections.length - 60)} more sections — refine the search</p>` : "");
    }

    // ============================== boot =====================================
    wireUpButtons(document.getElementById("panel-contribute"));

    // warm the small metadata files so switching sources feels instant
    const warm = () => {
      for (const s of SOURCES) {
        if (s.id !== "curlie" && s.id !== "contribute") {
          fetch(`data/${s.id}/meta.json`).catch(() => {});
        }
      }
    };
    if ("requestIdleCallback" in window) requestIdleCallback(warm, { timeout: 5000 });
    else setTimeout(warm, 2500);

    const themeBtn = document.getElementById("theme-toggle");
    themeBtn?.addEventListener("click", () => {
      const next =
        document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    });

    route();
  </script>
</BaseLayout>
